# ALAS Gateway — Environment Configuration

# Gateway server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001

# Agent service (separate process)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_WS_URL=ws://localhost:8000

# Auth
JWT_SECRET=change-me-in-production-use-secrets-token-hex-32
JWT_EXPIRY_SECONDS=3600
DEMO_MODE=true         # set false to enforce JWT on every request
REQUIRE_AUTH=false     # set true to reject unauthenticated WS connections

# Session persistence
PERSIST_SESSIONS=false                         # true = SQLite, false = in-memory
SESSION_DB_PATH=./data/gateway_sessions.db
SESSION_TTL_SECONDS=3600

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
