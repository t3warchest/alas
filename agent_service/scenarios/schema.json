{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alas.dev/schemas/scenario-v1.json",
  "title": "ALAS Scenario Schema v1",
  "description": "Complete definition of a conversational simulation scenario.",
  "type": "object",
  "required": [
    "id", "version", "title", "description", "category",
    "persona", "student_objective", "phases",
    "skill_dimensions", "rubric", "knowledge_chunks", "exit_conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "id":          { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "version":     { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "title":       { "type": "string", "minLength": 5 },
    "description": { "type": "string", "minLength": 10 },
    "category":    { "type": "string", "enum": ["interview", "feedback", "negotiation", "onboarding", "custom"] },
    "difficulty":  { "type": "string", "enum": ["beginner", "intermediate", "advanced"], "default": "intermediate" },
    "tags":        { "type": "array", "items": { "type": "string" } },

    "persona": {
      "type": "object",
      "required": ["name", "role", "emotional_start", "style", "constraints"],
      "additionalProperties": false,
      "properties": {
        "name":             { "type": "string" },
        "role":             { "type": "string" },
        "emotional_start":  { "type": "string", "enum": ["neutral", "defensive", "curious", "warm", "hostile", "anxious"] },
        "style":            { "type": "string" },
        "backstory":        { "type": "string" },
        "constraints":      { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },

    "student_objective": { "type": "string", "minLength": 20 },

    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "max_turns", "transition"],
        "additionalProperties": false,
        "properties": {
          "name":        { "type": "string" },
          "description": { "type": "string" },
          "max_turns":   { "type": "integer", "minimum": 1, "maximum": 30 },
          "avatar_goal": { "type": "string" },
          "transition": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["always_after_max", "score_threshold", "keyword_detected", "branch_table"]
              },
              "target_phase":     { "type": "string" },
              "score_dimension":  { "type": "string" },
              "score_threshold":  { "type": "number", "minimum": 0, "maximum": 1 },
              "keywords":         { "type": "array", "items": { "type": "string" } },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["condition", "target_phase"],
                  "properties": {
                    "condition":    { "type": "string" },
                    "target_phase": { "type": "string" },
                    "priority":     { "type": "integer", "default": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },

    "skill_dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },

    "rubric": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["1", "3", "5"],
        "additionalProperties": false,
        "properties": {
          "1": { "type": "string" },
          "2": { "type": "string" },
          "3": { "type": "string" },
          "4": { "type": "string" },
          "5": { "type": "string" }
        }
      }
    },

    "knowledge_chunks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 20 }
    },

    "exit_conditions": {
      "type": "object",
      "required": ["max_total_turns", "completion_phases"],
      "additionalProperties": false,
      "properties": {
        "max_total_turns":    { "type": "integer", "minimum": 2, "maximum": 60 },
        "completion_phases":  { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "early_exit_score":   { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
